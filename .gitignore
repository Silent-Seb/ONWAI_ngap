/target
**/*.rs.bk
.idea/
.vscode/
*.swp
# scratch output of `cargo xtask gen --out` / `check`
/.xtask-tmp/
# the 3GPP spec (docx) and the ASN.1 extracted from it are NOT vendored (see codegen/spec-source.toml)
/specs/*
!/specs/asn1/

# cargo-fuzz (see fuzz/README.md)
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/Cargo.lock

# private raw captures stay local (the published one is crates/onwai-ngap/tests/captures/5g_attach.pcap)
/captures/
